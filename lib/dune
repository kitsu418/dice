(menhir
 (modules Parser)
 (flags "--table"))

(ocamllex lexer)

(rule
 (enabled_if (= %{system} macosx))
 (deps (source_tree ../rsdd))
 (targets librsdd.a dllrsdd.so)
 (action
  (no-infer
    (progn
      (chdir ../rsdd (run cargo build --release))
      (copy ../rsdd/target/release/librsdd.dylib dllrsdd.so
      )
      (copy ../rsdd/target/release/librsdd.a librsdd.a)
      ))))

(rule
 (enabled_if (<> %{system} macosx))
 (deps (source_tree ../rsdd))
 (targets librsdd.a dllrsdd.so)
 (action
  (no-infer
    (progn
      (chdir ../rsdd (run cargo build --release))
      (copy ../rsdd/target/release/librsdd.so dllrsdd.so)
      (copy ../rsdd/target/release/librsdd.a librsdd.a)
      ))))


(library
 (libraries core core_unix.sys_unix cudd sexplib menhirLib ounit2 ctypes ctypes.foreign bignum)
 (foreign_archives rsdd)
 (library_flags (-linkall))
 (name diceLib)
 (preprocess (pps ppx_jane))
 (modules Bdd BddUtil Compiler CoreGrammar ExternalGrammar lexer LogProbability Optimization Parser
   Parser_messages Passes Util VarState Wmc))

(executable
 (name dice_bindings)
 (libraries core diceLib)
 (modules dice_bindings)
 (preprocess
  (pps ppx_jane))
 (modes (native shared_object))
 (link_flags (-cclib -L/usr/lib/x86_64-linux-gnu) (-linkall))
 ; (link_flags (-cclib -L%{env:C_LIB_PATH=/}))
 (foreign_stubs
  (language c)
  (names dice_stubs)))

(rule
 (action
  (copy dice_bindings.so libdice_bindings.so)))